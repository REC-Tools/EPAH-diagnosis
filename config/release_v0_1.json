    "municipality_comparison.csv",
    "municipality_profile.geojson",
    "readiness.json",
    "release_manifest.json",
    "RELEASE_NOTES.md",
    "completeness.xlsx",
    "diagnostic_report.pdf",
    "maps/map_population_65_plus.png",
    "maps/map_income_vulnerability.png",
    "maps/map_old_building_stock.png",
    "maps/map_heating_degree_days.png",
    "maps/map_mean_altitude.png",
    "maps/map_dea_access_minutes.png",
    "maps/map_upper_secondary_access_minutes.png",
    "maps/map_rail_access_minutes.png",
    "maps/map_snai_classification.png"
