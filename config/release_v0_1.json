    },
    {
      "id": "heat_stress_days",
      "stage": "blocked_authentication",
      "blocking": false,
      "dependency": "Copernicus CDS authentication and ERA5-HEAT download"
    },
    {
      "id": "non_natural_gas_heating_share",
      "stage": "implemented_input_required",
      "blocking": false,
      "dependency": "Official ISTAT municipality heating fuel-mix export"
